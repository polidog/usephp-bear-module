<?php

declare(strict_types=1);

use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;
use Polidog\UsePhp\Storage\StorageType;

use function Polidog\UsePhp\Runtime\fc;
use function Polidog\UsePhp\Runtime\useState;

return fc(function (array $props): Element {
    [$count, $setCount] = useState((int) ($props['count'] ?? 0));
    $next = (int) ($props['next'] ?? ($count + 1));

    return <div>
        <span data-test="count">{(string) $count}</span>
        <button onClick={fn() => $setCount($next)}>+1</button>
    </div>;
}, 'hook-counter', StorageType::Snapshot);
