<?php

declare(strict_types=1);

use Polidog\UsePhp\Html\H;
use Polidog\UsePhp\Runtime\Element;

return function (array $props): Element {
    $count = (int) ($props['count'] ?? 0);
    $label = (string) ($props['label'] ?? 'Count');

    return <div className="counter">
        <h1>{$label}</h1>
        <p>{"$label is $count"}</p>
    </div>;
};
