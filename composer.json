{
    "name": "polidog/usephp-bear-module",
    "description": "BEAR.Sunday module that renders ResourceObjects via polidog/use-php's PSX (TSX-like) templates",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Polidog\\UsePhpBearModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polidog\\UsePhpBearModule\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "polidog",
            "email": "polidogs@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "polidog/use-php": "^0.6.0",
        "bear/resource": "^1.20",
        "ray/di": "^2.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
