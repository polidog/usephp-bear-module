{
    "name": "polidog/usephp-bear-renderer",
    "description": "BEAR.Resource RenderInterface adapter that renders PSX (TSX-like) templates from polidog/use-php",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Polidog\\UsephpBearRenderer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Polidog\\UsephpBearRenderer\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "polidog",
            "email": "polidogs@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "polidog/use-php": "dev-main@dev",
        "bear/resource": "^1.20",
        "ray/di": "^2.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
